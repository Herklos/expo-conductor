{
  "description": "nextRun(spec, fromMs) -> next UTC epoch ms strictly greater than fromMs, or null.",
  "cases": [
    {
      "name": "interval: from before anchor returns anchor",
      "spec": { "kind": "interval", "everyMs": 1000, "anchor": 5000 },
      "fromMs": 0,
      "expected": 5000
    },
    {
      "name": "interval: aligns to next multiple after anchor",
      "spec": { "kind": "interval", "everyMs": 1000, "anchor": 0 },
      "fromMs": 2500,
      "expected": 3000
    },
    {
      "name": "interval: exact boundary advances one step",
      "spec": { "kind": "interval", "everyMs": 1000, "anchor": 0 },
      "fromMs": 3000,
      "expected": 4000
    },
    {
      "name": "interval: default anchor 0",
      "spec": { "kind": "interval", "everyMs": 900000 },
      "fromMs": 0,
      "expected": 900000
    },
    {
      "name": "interval: large gap from anchor",
      "spec": { "kind": "interval", "everyMs": 60000, "anchor": 100 },
      "fromMs": 500000,
      "expected": 540100
    },
    {
      "name": "daily: next 09:30 UTC same day",
      "spec": { "kind": "daily", "hour": 9, "minute": 30 },
      "fromMs": 0,
      "expected": 34200000
    },
    {
      "name": "daily: exact time advances to next day",
      "spec": { "kind": "daily", "hour": 9, "minute": 30 },
      "fromMs": 34200000,
      "expected": 120600000
    },
    {
      "name": "daily: after time advances to next day",
      "spec": { "kind": "daily", "hour": 9, "minute": 30 },
      "fromMs": 50000000,
      "expected": 120600000
    },
    {
      "name": "daily: midnight",
      "spec": { "kind": "daily", "hour": 0, "minute": 0 },
      "fromMs": 100,
      "expected": 86400000
    },
    {
      "name": "weekly: Friday 00:00 from epoch (Thursday)",
      "spec": { "kind": "weekly", "weekday": 5, "hour": 0, "minute": 0 },
      "fromMs": 0,
      "expected": 86400000
    },
    {
      "name": "weekly: Thursday 00:00 from epoch advances one week",
      "spec": { "kind": "weekly", "weekday": 4, "hour": 0, "minute": 0 },
      "fromMs": 0,
      "expected": 604800000
    },
    {
      "name": "weekly: Sunday 12:00",
      "spec": { "kind": "weekly", "weekday": 0, "hour": 12, "minute": 0 },
      "fromMs": 0,
      "expected": 302400000
    },
    {
      "name": "cron: every 15 minutes (minute hour dayOfWeek)",
      "spec": { "kind": "cron", "expression": "*/15 * *" },
      "fromMs": 0,
      "expected": 900000
    },
    {
      "name": "cron: every 15 minutes from boundary",
      "spec": { "kind": "cron", "expression": "*/15 * *" },
      "fromMs": 900000,
      "expected": 1800000
    },
    {
      "name": "cron: daily at 09:30",
      "spec": { "kind": "cron", "expression": "30 9 *" },
      "fromMs": 0,
      "expected": 34200000
    },
    {
      "name": "cron: list of minutes",
      "spec": { "kind": "cron", "expression": "0,30 * *" },
      "fromMs": 100000,
      "expected": 1800000
    },
    {
      "name": "cron: specific weekday (Friday) at 00:00",
      "spec": { "kind": "cron", "expression": "0 0 5" },
      "fromMs": 0,
      "expected": 86400000
    },
    {
      "name": "cron: every 6 hours (*/step on hour field)",
      "spec": { "kind": "cron", "expression": "0 */6 *" },
      "fromMs": 0,
      "expected": 21600000
    },
    {
      "name": "weekly: on target weekday but past the time wraps a week",
      "spec": { "kind": "weekly", "weekday": 4, "hour": 0, "minute": 0 },
      "fromMs": 3600000,
      "expected": 604800000
    },
    {
      "name": "daily: from a large fromMs many days out",
      "spec": { "kind": "daily", "hour": 0, "minute": 0 },
      "fromMs": 8640000000,
      "expected": 8726400000
    },
    {
      "name": "cron: malformed (2 fields) never fires",
      "spec": { "kind": "cron", "expression": "* *" },
      "fromMs": 0,
      "expected": null
    },
    {
      "name": "cron: malformed (4 fields) never fires",
      "spec": { "kind": "cron", "expression": "30 9 * extra" },
      "fromMs": 0,
      "expected": null
    },
    {
      "name": "cron: non-numeric token never fires",
      "spec": { "kind": "cron", "expression": "30abc 9 *" },
      "fromMs": 0,
      "expected": null
    },
    {
      "name": "cron: NBSP is not a field separator (malformed -> never fires)",
      "spec": { "kind": "cron", "expression": "0 0 5" },
      "fromMs": 0,
      "expected": null
    },
    {
      "name": "cron: form-feed is not a field separator (malformed -> never fires)",
      "spec": { "kind": "cron", "expression": "0 0\f5" },
      "fromMs": 0,
      "expected": null
    }
  ]
}
