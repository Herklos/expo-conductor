<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Baseline permissions for the conductor triggers. Exact-alarm permissions are
       intentionally NOT declared here: SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM (the latter
       Play-restricted) are added conditionally by the config plugin when
       `enableExactAlarms` is set, so apps that don't use exact alarms don't ship them. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Exact-alarm trigger receiver. -->
    <receiver
      android:name=".triggers.ConductorAlarmReceiver"
      android:exported="false" />

    <!-- Reschedules persisted alarms after a device reboot. -->
    <receiver
      android:name=".triggers.BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
