{
  "name": "@drakkar.software/expo-conductor",
  "version": "0.2.2",
  "description": "Define tasks in an Expo app with rich execution policies (time, notifications, FCM/push, alarms, background) — priority, resource weight, recurrence and constraints. Native-first engine on Android (Kotlin) and iOS (Swift) with a Web implementation.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./task-manager": {
      "types": "./build/integrations/expoBackgroundTask.d.ts",
      "default": "./build/integrations/expoBackgroundTask.js"
    },
    "./notifications": {
      "types": "./build/integrations/expoNotifications.d.ts",
      "default": "./build/integrations/expoNotifications.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p plugin/tsconfig.json",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "clean": "rm -rf build plugin/build",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p plugin/tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run test && pnpm run build",
    "publish:public": "pnpm publish --access public"
  },
  "keywords": [
    "expo",
    "react-native",
    "expo-modules",
    "task",
    "scheduler",
    "background-task",
    "notifications",
    "fcm",
    "alarm",
    "cron",
    "recurrence"
  ],
  "license": "MIT",
  "homepage": "https://github.com/herklos/expo-conductor",
  "repository": {
    "type": "git",
    "url": "https://github.com/herklos/expo-conductor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "CHANGELOG.md",
    "android/build.gradle",
    "android/src",
    "ios/ExpoConductor.podspec",
    "ios/ExpoConductorModule.swift",
    "ios/ConductorAppDelegate.swift",
    "ios/ConductorTaskHandler.swift",
    "ios/Engine",
    "ios/Triggers",
    "plugin/build",
    "expo-module.config.json",
    "app.plugin.js"
  ],
  "peerDependencies": {
    "expo": "*",
    "expo-background-task": "*",
    "expo-notifications": "*",
    "expo-task-manager": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-background-task": { "optional": true },
    "expo-notifications": { "optional": true },
    "expo-task-manager": { "optional": true }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.0",
    "expo-background-task": "*",
    "expo-modules-core": "*",
    "expo-notifications": "*",
    "expo-task-manager": "*",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.3"
  }
}
