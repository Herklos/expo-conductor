{
  "expo": {
    "name": "Conductor Demo",
    "slug": "expo-conductor-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "software.drakkar.expoconductor.demo"
    },
    "android": {
      "package": "software.drakkar.expoconductor.demo"
    },
    "plugins": [
      [
        "expo-conductor",
        {
          "enableFcm": false,
          "enableExactAlarms": true,
          "enableRust": true,
          "rustLibName": "conductor_demo_ffi",
          "backgroundTaskIdentifiers": ["software.drakkar.expoconductor.refresh"]
        }
      ],
      "./conductor-rust.plugin"
    ]
  }
}
