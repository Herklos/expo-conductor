{
  "expo": {
    "name": "Conductor Demo",
    "slug": "expo-conductor-demo",
    "icon": "./assets/icon.png",
    "scheme": "expoconductordemo",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d259c4e5-a1f1-4e59-a558-551fa80200d7",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "software.drakkar.expoconductor.demo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "software.drakkar.expoconductor.demo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101420"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-conductor",
        {
          "enableFcm": false,
          "enableExactAlarms": true,
          "enableForegroundService": true,
          "enableRust": true,
          "rustLibName": "conductor_demo_ffi",
          "backgroundTaskIdentifiers": [
            "software.drakkar.expoconductor.refresh"
          ]
        }
      ],
      "./conductor-rust.plugin",
      "expo-status-bar",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "d259c4e5-a1f1-4e59-a558-551fa80200d7"
      }
    }
  }
}
