{
  "expo": {
    "name": "Conductor Demo",
    "slug": "expo-conductor-demo",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d259c4e5-a1f1-4e59-a558-551fa80200d7",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "software.drakkar.expoconductor.demo"
    },
    "android": {
      "package": "software.drakkar.expoconductor.demo",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-conductor",
        {
          "enableFcm": false,
          "enableExactAlarms": true,
          "enableRust": true,
          "rustLibName": "conductor_demo_ffi",
          "backgroundTaskIdentifiers": [
            "software.drakkar.expoconductor.refresh"
          ]
        }
      ],
      "./conductor-rust.plugin"
    ],
    "extra": {
      "eas": {
        "projectId": "d259c4e5-a1f1-4e59-a558-551fa80200d7"
      }
    }
  }
}
